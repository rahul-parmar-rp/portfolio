{
  "manifest_version": 3,
  "name": "Audio Loop Player",
  "version": "1.0.0",
  "description": "Play local audio files in an infinite loop",
  "permissions": ["storage", "offscreen"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
